{
    "name": "tekwing/multipay",
    "description": "A reusable Stripe and Razorpay gateway manager for Laravel.",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "stripe/stripe-php": "^13.0",
        "razorpay/razorpay": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "Tekwing\\MultiPay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tekwing\\MultiPay\\Providers\\PaymentGatewayServiceProvider"
            ]
        }
    }
}